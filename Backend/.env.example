# Copy to .env and generate JWT_SECRET with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
ENVIRONMENT=development
FRONTEND_URL=http://127.0.0.1:4300
ALLOWED_ORIGINS=http://localhost:4200,http://localhost:4300,http://127.0.0.1:4200,http://127.0.0.1:4300,http://localhost:4000,http://127.0.0.1:4000
COOKIE_SECURE=false
# Local development defaults to SQLite. MySQL:
# DATABASE_URL=mysql+pymysql://kingai:YOUR_PASSWORD@127.0.0.1:3306/kingai?charset=utf8mb4
ACCESS_MINUTES=15
WORKSPACE_HOURS=8
REFRESH_DAYS=30
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=


# Calls: configure a reachable TURN service for separate computers/networks.
WEBRTC_STUN_URLS=stun:stun.l.google.com:19302
WEBRTC_TURN_URL=
WEBRTC_TURN_USERNAME=
WEBRTC_TURN_PASSWORD=
