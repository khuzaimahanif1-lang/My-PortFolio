# Use random URL-safe values, never commit the real .env.
MYSQL_PASSWORD=replace-with-a-random-url-safe-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-random-password
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
ENVIRONMENT=development
COOKIE_SECURE=false
FRONTEND_URL=http://localhost:4000
ALLOWED_ORIGINS=http://localhost:4000


SSR_ALLOWED_HOSTS=localhost,127.0.0.1

# Network-accessible TURN relay for calls between computers.
WEBRTC_STUN_URLS=stun:stun.l.google.com:19302
WEBRTC_TURN_URL=
WEBRTC_TURN_USERNAME=
WEBRTC_TURN_PASSWORD=
